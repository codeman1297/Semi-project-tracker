# Copy to .env (which is gitignored) and fill in. Nothing here is required for
# the core pipeline to run.

# Optional: enables `ism-tracker ingest --llm`. Without it, extraction is
# rules-only and everything still works.
ANTHROPIC_API_KEY=
ISM_TRACKER_LLM_MODEL=claude-sonnet-5

# Sent on every outbound request. Point the contact URL at something real
# before running ingest against live sites.
ISM_TRACKER_USER_AGENT=ism-tracker/0.1 (+https://github.com/codeman1297/semi-project-tracker; public dataset bot)
ISM_TRACKER_REQUEST_DELAY=2.0
ISM_TRACKER_REQUEST_TIMEOUT=30

# Published site URL and the address on the corrections page.
ISM_TRACKER_SITE_URL=https://example.invalid/ism-tracker
ISM_TRACKER_CONTACT=corrections@example.invalid

# Verification staleness threshold, in days.
ISM_TRACKER_STALE_DAYS=60
